# Copy this file to .env and fill in real values.
# Never commit the real .env to git.

# ── Source: MySQL (reporting) on 192.1.1.38 ─────────────────────
MYSQL_HOST=192.1.1.38
MYSQL_USER=talend
MYSQL_PASSWORD=
MYSQL_DATABASE=reporting

# ── Target: Supabase ─────────────────────────────────────────────
# Settings → API in your Supabase project dashboard.
# Use the service_role key here (NOT the anon key) - this script
# runs only on your own server/PC, never in a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LAN-only live API (api-server.js) ────────────────────────────
# Port for the local Dispatch/Receiving live-data server. Only reachable
# from machines on the same network - do not port-forward this.
API_PORT=3001
